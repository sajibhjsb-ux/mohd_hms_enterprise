  actorId      String?
  actor        User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorEmail   String   @default("")
  action       String
  resourceType String   @default("")
  resourceId   String   @default("")
  metadata     String   @default("")
  ip           String   @default("")
  createdAt    DateTime @default(now())

