// MOHD.HMS ENTERPRISE — Database Schema
// Domains: Auth, Users, Roles, Sessions, Customers, Employees, Technicians,
// Equipment, Assets, Locations, Complaints, Work Orders, PM, Inspections/IRMS,
// Inventory, Suppliers, Purchases, Quotations, Invoices, Payments, Finance,
// HR, Vehicles, Notifications, Documents, Settings, Audit Logs, Drafts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // NOTE: the running datastore is the SQLite file DB (db/custom.db, see .env).
  // Production may point PostgreSQL — flip provider + DATABASE_URL together;
  // the CLI rejects a postgres:// provider with a file: URL.
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────── AUTH / USERS / RBAC ───────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  name          String
  phone         String?
  // SUPER_ADMIN | ADMIN | SUPERVISOR | TECHNICIAN | CUSTOMER | FINANCE | HR
  role          String    @default("CUSTOMER")
  status        String    @default("ACTIVE") // ACTIVE | DISABLED
  emailVerified DateTime?
  lastLoginAt   DateTime?
  // Google OAuth sign-in (linked to existing accounts by verified email)
  googleId      String?   @unique
  avatarUrl     String?
  customerId    String?   @unique
  customer      Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  // JOB POSITION (organizational job title) — SEPARATE from `role`.
  // `role` is the RBAC access level (authorization); positionId is the
  // person's job title from the HR position catalog and NEVER affects
  // permissions. Canonical for the account; mirrored onto the linked
  // Employee record when one exists (same person, one job title).
  positionId    String?
  position      JobPosition? @relation(fields: [positionId], references: [id], onDelete: SetNull)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  createdBy     String?

  sessions          Session[]
  passwordResets    PasswordResetToken[]
  emailOtps         EmailOtp[]
  pushSubscriptions PushSubscription[]
  pushDevices       PushDevice[]
  pushLogs          PushLog[]
  notificationPreference NotificationPreference?
  technicianProfile TechnicianProfile?
  employee          Employee?
  notifications     Notification[]
  auditLogs         AuditLog[]
  attendance        Attendance[]
  legalAcceptances  LegalAcceptance[]
  whatsappContacts  WhatsAppContact[]    @relation("WhatsAppContactUser")
  profileChangeRequests ProfileChangeRequest[]
  // Payroll actors (spec §9 — every workflow step is attributable)
  payrollRunsCreated   PayrollRun[] @relation("PayrollRunCreator")
  payrollRunsSubmitted PayrollRun[] @relation("PayrollRunSubmitter")
  payrollRunsApproved  PayrollRun[] @relation("PayrollRunApprover")
  payrollRunsFinalized PayrollRun[] @relation("PayrollRunFinalizer")
  payrollRunsPaid      PayrollRun[] @relation("PayrollRunPayer")
  payrollRunsLocked    PayrollRun[] @relation("PayrollRunLocker")
  overtimeApproved     OvertimeRequest[] @relation("OvertimeApprover")

  @@index([role])
  @@index([status])
  @@index([positionId])
}

model Session {
  id         String   @id @default(cuid())
  token      String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  // Idle-timeout clock (spec: auto logout after inactivity). Advanced ONLY by
  // genuine-user-activity reports — background polling/heartbeat/WS traffic
  // never touches it. The server enforces: idle >= SESSION_IDLE_TIMEOUT_MS
  // invalidates the session on the next authenticated request.
  lastActivityAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Email-verification one-time codes (e.g. customer first credentials login).
// Only the HASH of the 6-digit code is stored; one active code per user+purpose
// (resend overwrites = invalidates the previous code). Delivery mirrors the
// established sandbox pattern: EMAIL channel logged, dev mailbox in Setting.
model EmailOtp {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose    String    @default("EMAIL_VERIFICATION")
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  lastSentAt DateTime  @default(now())
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([userId, purpose])
  @@index([userId])
}

// Web Push subscription (PWA push notifications). One user may register
// several devices; endpoint is the provider-unique key. Revoked rows are kept
// for audit and cleaned by expired-subscription pruning.
model PushSubscription {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint   String    @unique
  p256dh     String
  auth       String
  deviceName String?
  platform   String?
  browser    String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  lastSeenAt DateTime?
  revokedAt  DateTime?

  @@index([userId, revokedAt])
}

// FCM device registry (spec §6 "notification_devices"). One row per Firebase
// Installation/registration token — a browser/PWA install may register once and
// refresh its token in place (upsert by token). Multiple devices per user are
// supported and expected. The token is a provider-generated opaque identifier
// (NOT a secret); server credentials never touch this table.
model PushDevice {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // FCM registration token — provider-unique key for this browser install.
  token            String    @unique
  // Firebase Installation ID (current Firebase-recommended device identifier).
  installationId   String    @default("")
  platform         String    @default("WEB") // WEB | ANDROID | IOS
  deviceName       String?
  browser          String?
  operatingSystem  String?
  appVersion       String?
  // GRANTED | DENIED — permission state reported at registration time.
  permissionStatus String    @default("GRANTED")
  active           Boolean   @default(true)
  // Login-session binding (logout policy §34): the last session that
  // registered/refreshed this device. Cleared on self-unregister.
  lastSessionId    String    @default("")
  // Consecutive permanent/transient failure bookkeeping (worker prunes at >=5).
  failureCount     Int       @default(0)
  lastError        String    @default("")
  lastSeenAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([userId, active])
  @@index([active, updatedAt])
}

// Push delivery log — the authoritative history for the push channel
// (EmailLog pattern): QUEUED → SENDING → SENT / FAILED (retry w/ backoff)
// → DEAD_LETTER, or SKIPPED when the channel cannot attempt delivery.
// One row per recipient per business notification (fan-out counts inside).
model PushLog {
  id             String    @id @default(cuid())
  status         String    @default("QUEUED")
  // Idempotency: the in-app Notification id this push belongs to ("" for
  // direct/admin/test sends). The enqueue path never creates a second QUEUED
  // row for the same notificationId+user.
  dedupeKey      String    @default("")
  // DomainEvent id that produced this push ("" for direct/admin sends).
  eventId        String    @default("")
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  notificationId String    @default("") // in-app Notification id (soft reference, not an FK — "" for direct sends)
  type           String    @default("INFO") // INFO | SUCCESS | WARNING | ERROR
  title          String
  body           String
  resourceType   String    @default("")
  resourceId     String    @default("")
  // Server-computed application route (RBAC applied per module — §15).
  route          String    @default("/dashboard")
  priority       String    @default("NORMAL") // NORMAL | HIGH | CRITICAL
  // Transport actually used: FCM | VAPID (legacy web-push fallback).
  channel        String    @default("FCM")
  deviceCount    Int       @default(0)
  sentCount      Int       @default(0)
  failedCount    Int       @default(0)
  skippedCount   Int       @default(0)
  attemptCount   Int       @default(0)
  maxAttempts    Int       @default(3)
  scheduledAt    DateTime  @default(now())
  sentAt         DateTime?
  lastError      String    @default("")
  // Transient | Permanent | Unconfigured | ChannelDisabled | Throttled
  errorCode      String    @default("")
  // First FCM message id on partial success (per-message ids are per token).
  fcmMessageId   String    @default("")
  // Admin/test targeting: restrict delivery to ONE device id ("" = all of the
  // user's active devices).
  targetDeviceId String    @default("")
  // Admin test sends are always clearly marked.
  isTest         Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, scheduledAt])
  @@index([userId, createdAt])
  @@index([dedupeKey])
  @@index([channel, status, createdAt])
}

// Per-user notification preferences (spec §19). One row per user; `channels`
// is a JSON map category → { push: boolean } (absent category = default on).
// Categories mirror the business domains (COMPLAINTS, WORK_ORDERS, PM,
// INVOICES, QUOTATIONS, PAYMENTS, EQUIPMENT, IRMS, HR, SYSTEM_ALERTS).
// In-app/Email/WhatsApp remain governed by the existing business rules and
// automation toggles — preferences only gate the user-facing push channel.
model NotificationPreference {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  channels  String   @default("{}")
  updatedAt DateTime @updatedAt
}

model TechnicianProfile {
  id              String  @id @default(cuid())
  userId          String  @unique
  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeNo      String  @unique
  skills          String  @default("") // comma separated
  specialty       String  @default("GENERAL")
  hourlyRateCents Int     @default(0)
  status          String  @default("AVAILABLE") // AVAILABLE | ON_JOB | OFF_DUTY | RETIRED (RETIRED = user no longer holds the TECHNICIAN role — profile kept for history; hidden from roster/assignment dropdowns)
  vehicleId       String? @unique

  complaints  Complaint[]        @relation("assignedComplaints")
  workOrders  WorkOrder[]        @relation("assignedWorkOrders")
  pmPlans     PmPlan[]           @relation("assignedPmPlans")
  pmTasks     PmTask[]           @relation("assignedPmTasks")
  inspections InspectionReport[] @relation("inspectorReports")
  vehicles    Vehicle[]          @relation("vehicleAssignee")
}

// ─────────────────────────── CUSTOMERS ───────────────────────────

model Customer {
  id            String   @id @default(cuid())
  code          String   @unique
  // Company name is OPTIONAL for customers — an account may be an individual,
  // homeowner, tenant or corporate contact. Empty string = not provided.
  companyName   String   @default("")
  contactPerson String
  email         String
  // Mobile number starts empty for self-provisioned (e.g. Google) customers and
  // is completed during mandatory profile onboarding.
  phone         String   @default("")
  address       String   @default("")
  city          String   @default("")
  country       String   @default("Brunei Darussalam")
  status        String   @default("ACTIVE") // ACTIVE | INACTIVE
  notes         String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  portalUser            User?
  equipment             Equipment[]
  complaints            Complaint[]
  workOrders            WorkOrder[]
  quotations            Quotation[]
  invoices              Invoice[]
  payments              Payment[]
  irmsProjects          IrmsProject[]
  whatsappContacts      WhatsAppContact[]
  whatsappConversations WhatsAppConversation[] @relation("WhatsAppConversationCustomer")
}

// ─────────────────────────── HR / EMPLOYEES ───────────────────────────

model Department {
  id          String @id @default(cuid())
  name        String @unique
  description String @default("")

  employees   Employee[]
  jobPositions JobPosition[]
}

// ── Position catalog (HR master data, spec §9/§24) ──
// Managed job titles, SEPARATE from application roles: a position describes
// WHAT a person's job is ("Finance Director"), a role describes what they may
// DO in the application (ADMIN). Positions are deactivated — never deleted —
// so historical employee records stay valid.
model JobPosition {
  id           String      @id @default(cuid())
  name         String      @unique
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  description  String      @default("")
  status       String      @default("ACTIVE") // ACTIVE | INACTIVE
  createdBy    String?
  updatedBy    String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  employees Employee[]
  users     User[]
}

model Employee {
  id           String      @id @default(cuid())
  employeeNo   String      @unique
  userId       String?     @unique
  user         User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  firstName    String
  lastName     String
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  // Free-text job title kept for display/history (letters, attendance,
  // profile). The managed source is positionRef (catalog FK) — the string is
  // snapshotted from the catalog name on every catalog-linked write so
  // legacy readers stay untouched.
  position     String      @default("")
  positionId   String?
  positionRef  JobPosition? @relation(fields: [positionId], references: [id], onDelete: SetNull)
  email        String      @default("")
  phone        String      @default("")
  address      String      @default("")
  country      String      @default("Brunei Darussalam")
  joinDate     DateTime?
  salaryCents  Int         @default(0)
  status       String      @default("ACTIVE") // ACTIVE | ON_LEAVE | TERMINATED
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  leaveRequests     LeaveRequest[]
  letters           Letter[]
  attendance        Attendance[]
  // Payroll (spec: PAYROLL SYSTEM UNDER HR) — money is Int cents (house convention)
  salaryStructures  SalaryStructure[]
  payrollItems      PayrollItem[]
  payrollAdjustments PayrollAdjustment[]
  overtimeRequests  OvertimeRequest[]
}

model Attendance {
  id         String    @id @default(cuid())
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  date       DateTime
  status     String    @default("PRESENT") // PRESENT | ABSENT | LEAVE | HALF_DAY
  checkIn    DateTime?
  checkOut   DateTime?
  notes      String    @default("")

  @@unique([employeeId, date])
  @@index([date])
}

model LeaveRequest {
  id           String    @id @default(cuid())
  employeeId   String
  employee     Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type         String    @default("ANNUAL") // ANNUAL | SICK | UNPAID | OTHER
  startDate    DateTime
  endDate      DateTime
  days         Int       @default(1)
  reason       String    @default("")
  status       String    @default("PENDING") // PENDING | APPROVED | REJECTED
  approvedById String?
  approvedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([status])
}

// ─────────────────────────── PAYROLL (UNDER HR) ───────────────────────────
// PAYROLL SYSTEM (spec §58 — smallest clean model, reuses canonical Employee).
// All money is stored as Int cents (BND). ROLE / POSITION / SALARY stay
// separate axes: role = User.role (RBAC), position = Employee.positionRef
// (job title snapshot on items), salary = the structures below.

// Configurable salary components catalog (spec §6). Engine-managed "system"
// components (BASIC / OVERTIME / UNPAID_LEAVE) cannot be deleted.
model SalaryComponent {
  id          String   @id @default(cuid())
  name        String   @unique
  type        String   @default("EARNING")  // EARNING | DEDUCTION
  category    String   @default("ALLOWANCE") // BASIC | ALLOWANCE | OVERTIME | BONUS | COMMISSION | REIMBURSEMENT | STATUTORY | UNPAID_LEAVE | ABSENCE | LOAN | OTHER
  description String   @default("")
  taxable     Boolean  @default(false)
  system      Boolean  @default(false)      // engine-managed — hidden from delete
  active      Boolean  @default(true)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  structures SalaryStructure[]
}

// Effective-dated employee salary structure (spec §6/§7 — salary history with
// effective dates; history rows are never overwritten, only ended).
model SalaryStructure {
  id            String    @id @default(cuid())
  employeeId    String
  employee      Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  componentId   String
  component     SalaryComponent @relation(fields: [componentId], references: [id])
  amountCents   Int       @default(0)   // fixed monthly amount
  percentBps    Int?      // optional % of basic (basis points, 500 = 5%)
  effectiveFrom DateTime
  effectiveTo   DateTime? // null = current
  note          String    @default("")
  createdById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([employeeId, effectiveFrom])
  @@index([componentId])
}

// A payroll run for one period (spec §8/§9). periodKey unique → duplicate
// prevention (§55). Status machine: DRAFT → CALCULATING → REVIEW → APPROVED →
// FINALIZED → PAID → LOCKED (+ FAILED, CANCELLED).
model PayrollRun {
  id                String    @id @default(cuid())
  code              String    @unique // PRR-YYYY-NNNN via Counter
  periodKey         String    @unique // "2026-09" — one run per period
  name              String
  periodStart       DateTime
  periodEnd         DateTime
  frequency         String    @default("MONTHLY")
  status            String    @default("DRAFT") // DRAFT | CALCULATING | REVIEW | APPROVED | FINALIZED | PAID | LOCKED | FAILED | CANCELLED
  employeeCount     Int       @default(0)
  grossCents        Int       @default(0)
  deductionsCents   Int       @default(0)
  employerCostCents Int       @default(0)
  netCents          Int       @default(0)
  exceptionCount    Int       @default(0)
  payDate           DateTime?
  paymentRef        String    @default("")
  errorNote         String    @default("") // safe failure reason (§63)
  configJson        String    @default("") // engine config snapshot used (§46)
  createdById       String?
  submittedById     String?
  submittedAt       DateTime?
  approvedById      String?
  approvedAt        DateTime?
  finalizedById     String?
  finalizedAt       DateTime?
  paidById          String?
  paidAt            DateTime?
  lockedById        String?
  lockedAt          DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  creator   User? @relation("PayrollRunCreator", fields: [createdById], references: [id], onDelete: SetNull)
  submitter User? @relation("PayrollRunSubmitter", fields: [submittedById], references: [id], onDelete: SetNull)
  approver  User? @relation("PayrollRunApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  finalizer User? @relation("PayrollRunFinalizer", fields: [finalizedById], references: [id], onDelete: SetNull)
  payer     User? @relation("PayrollRunPayer", fields: [paidById], references: [id], onDelete: SetNull)
  lockUser  User? @relation("PayrollRunLocker", fields: [lockedById], references: [id], onDelete: SetNull)

  items       PayrollItem[]
  adjustments PayrollAdjustment[]

  @@index([status])
}

// Per-employee payroll calculation snapshot (spec §34/§46/§48 — fully
// traceable lines; immutable once the run is FINALIZED).
model PayrollItem {
  id                         String    @id @default(cuid())
  runId                      String
  run                        PayrollRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  employeeId                 String
  employee                   Employee  @relation(fields: [employeeId], references: [id])
  // snapshots (§46 — do not recalculate history with today's config)
  employeeNo                 String    @default("")
  employeeName               String    @default("")
  departmentName             String    @default("")
  positionName               String    @default("") // POSITION snapshot — never the RBAC role (§33)
  status                     String    @default("CALCULATED") // CALCULATED | EXCLUDED
  excludedReason             String    @default("")
  // attendance / leave inputs actually used
  workingDays                Int       @default(0)
  workedDays                 Int       @default(0)
  paidLeaveDays              Int       @default(0)
  unpaidLeaveDays            Int       @default(0)
  absentDays                 Int       @default(0)
  otMinutes                  Int       @default(0)
  // money (Int cents)
  basicCents                 Int       @default(0)
  allowancesCents            Int       @default(0)
  overtimeCents              Int       @default(0)
  bonusCents                 Int       @default(0)
  adjustmentsEarningsCents   Int       @default(0)
  grossCents                 Int       @default(0)
  statutoryCents             Int       @default(0) // employee statutory subtotal
  otherDeductionsCents       Int       @default(0)
  adjustmentsDeductionsCents Int       @default(0)
  deductionsCents            Int       @default(0)
  netCents                   Int       @default(0)
  employerCostCents          Int       @default(0)
  linesJson                  String    @default("[]") // traceable component lines (§48)
  // variance review (§44)
  varianceBps                Int?      // net change vs previous run (basis points)
  exceptionFlags             String    @default("") // JSON array of flag codes
  // stored payslip (§36 — PDF in MinIO, metadata here)
  payslipObjectKey           String?
  payslipSizeBytes           Int?
  payslipGeneratedAt         DateTime?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  @@unique([runId, employeeId]) // idempotency (§55)
  @@index([employeeId])
}

// Authorized payroll adjustment (spec §24) — never edit finalized values
// directly; adjustments are approved then included by recalculation.
model PayrollAdjustment {
  id           String    @id @default(cuid())
  runId        String
  run          PayrollRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  employeeId   String
  employee     Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  direction    String    @default("EARNING") // EARNING | DEDUCTION
  category     String    @default("CORRECTION") // ARREAR | CORRECTION | RETROACTIVE | BONUS | REIMBURSEMENT | OTHER
  amountCents  Int
  reason       String
  status       String    @default("PENDING") // PENDING | APPROVED | REJECTED | APPLIED
  appliedAt    DateTime?
  createdById  String?
  approvedById String?
  approvedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([runId])
  @@index([employeeId])
}

// Configurable + versioned statutory rules (spec §18/§19 — no hard-coded legal
// rates; EMPLOYEE rows deduct from net, EMPLOYER rows are cost-only).
model StatutoryRule {
  id               String    @id @default(cuid())
  name             String
  jurisdiction     String    @default("BN")
  category         String    @default("SOCIAL") // SOCIAL | TAX | OTHER
  payer            String    @default("EMPLOYEE") // EMPLOYEE (deducted) | EMPLOYER (employer cost)
  employeeCategory String    @default("ALL") // ALL | CITIZEN_PR | FOREIGN
  calcType         String    @default("PERCENTAGE") // PERCENTAGE | FIXED
  rateBps          Int       @default(0)  // 500 = 5.00%
  amountCents      Int       @default(0)  // for FIXED
  appliesTo        String    @default("GROSS") // GROSS | BASIC
  thresholdCents   Int       @default(0)  // base below this → not applicable
  effectiveFrom    DateTime
  effectiveTo      DateTime? // null = no expiry (versioned by dated rows)
  calcOrder        Int       @default(100)
  active           Boolean   @default(true)
  reference        String    @default("") // legal/company source reference
  notes            String    @default("")
  createdById      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([active, effectiveFrom])
}

// Overtime request with the existing HR approval pattern (spec §15 — only
// APPROVED overtime enters payroll; amount snapshotted at approval).
model OvertimeRequest {
  id            String    @id @default(cuid())
  employeeId    String
  employee      Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date          DateTime
  minutes       Int       @default(0) // stored in minutes for exactness
  multiplier    Float     @default(1.5)
  reason        String    @default("")
  status        String    @default("PENDING") // PENDING | APPROVED | REJECTED
  amountCents   Int       @default(0) // computed at approval (rate snapshot)
  rateBasisCents Int      @default(0) // hourly rate used at approval
  approvedById  String?
  approvedAt    DateTime?
  createdById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  approver User? @relation("OvertimeApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([employeeId, date])
}

// ─────────────────────────── LOCATIONS / EQUIPMENT ───────────────────────────

model Location {
  id          String @id @default(cuid())
  name        String
  code        String @unique
  description String @default("")

  equipment Equipment[]
}

model Equipment {
  id               String    @id @default(cuid())
  assetTag         String    @unique
  serialNumber     String    @default("")
  name             String
  manufacturer     String    @default("")
  model            String    @default("")
  category         String    @default("GENERAL")
  locationId       String?
  location         Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  customerId       String?
  customer         Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  installationDate DateTime?
  warrantyExpiry   DateTime?
  pmFrequencyDays  Int       @default(90)
  // LOW | MEDIUM | HIGH | CRITICAL (PM §34/§35 — drives default PM priority)
  criticality      String    @default("MEDIUM")
  status           String    @default("ACTIVE") // ACTIVE | UNDER_MAINTENANCE | RETIRED
  qrToken          String    @unique @default(cuid())
  notes            String    @default("")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  complaints  Complaint[]
  workOrders  WorkOrder[]
  pmPlans     PmPlan[]
  pmTasks     PmTask[]
  inspections InspectionReport[]
  meters      EquipmentMeter[]
  pmFindings  PmFinding[]
}

// ─────────────────────────── COMPLAINTS ───────────────────────────

model Complaint {
  id                   String             @id @default(cuid())
  code                 String             @unique
  customerId           String
  customer             Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  equipmentId          String?
  equipment            Equipment?         @relation(fields: [equipmentId], references: [id], onDelete: SetNull)
  title                String
  description          String
  priority             String             @default("MEDIUM") // LOW | MEDIUM | HIGH | URGENT
  // NEW → ASSIGNED → IN_PROGRESS → COMPLETED → CONFIRMED → CLOSED
  status               String             @default("NEW")
  createdById          String?
  assignedTechnicianId String?
  assignedTechnician   TechnicianProfile? @relation("assignedComplaints", fields: [assignedTechnicianId], references: [id], onDelete: SetNull)
  assignedAt           DateTime?
  acceptedAt           DateTime?
  startedAt            DateTime?
  completedAt          DateTime?
  confirmedAt          DateTime?
  closedAt             DateTime?
  resolutionNotes      String             @default("")
  customerFeedback     String             @default("")
  customerRating       Int?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  statusHistory ComplaintStatusHistory[]
  workOrders    WorkOrder[]

  @@index([status])
  @@index([customerId])
  @@index([assignedTechnicianId])
}

model ComplaintStatusHistory {
  id          String    @id @default(cuid())
  complaintId String
  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  fromStatus  String
  toStatus    String
  changedById String?
  note        String    @default("")
  createdAt   DateTime  @default(now())
}

// ─────────────────────────── WORK ORDERS ───────────────────────────

model WorkOrder {
  id                  String             @id @default(cuid())
  code                String             @unique
  complaintId         String?
  complaint           Complaint?         @relation(fields: [complaintId], references: [id], onDelete: SetNull)
  customerId          String
  customer            Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  equipmentId         String?
  equipment           Equipment?         @relation(fields: [equipmentId], references: [id], onDelete: SetNull)
  technicianId        String?
  technician          TechnicianProfile? @relation("assignedWorkOrders", fields: [technicianId], references: [id], onDelete: SetNull)
  title               String
  description         String             @default("")
  priority            String             @default("MEDIUM")
  // GENERAL | COMPLAINT | PM | CORRECTIVE (PM §22 — PM jobs reuse the canonical work-order system)
  sourceType          String             @default("GENERAL")
  status              String             @default("PENDING") // PENDING | ACCEPTED | IN_PROGRESS | ON_HOLD | COMPLETED | CANCELLED
  scheduledDate       DateTime?
  startedAt           DateTime?
  completedAt         DateTime?
  labourHours         Float              @default(0)
  labourRateCents     Int                @default(0)
  labourTotalCents    Int                @default(0)
  materialsTotalCents Int                @default(0)
  totalCents          Int                @default(0)
  notes               String             @default("")
  customerConfirmed   Boolean            @default(false)
  confirmedAt         DateTime?
  invoiceId           String?
  invoice             Invoice?           @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  // PM bridge: exactly one work order per PM occurrence (PM §22/§23 idempotency)
  pmTaskId            String?            @unique
  pmTask              PmTask?            @relation(fields: [pmTaskId], references: [id], onDelete: SetNull)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  checklist         WorkOrderChecklistItem[]
  materials         WorkOrderMaterial[]
  irmsReports       InspectionReport[]       @relation("irmsWorkOrders")
  pmFindingSource   PmFinding?               @relation("pmCorrectiveWorkOrders")
  checklistInstance ChecklistInstance?

  @@index([status])
  @@index([customerId])
  @@index([sourceType, status])
}

model WorkOrderChecklistItem {
  id           String    @id @default(cuid())
  workOrderId  String
  workOrder    WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  label        String
  done         Boolean   @default(false)
  doneAt       DateTime?
  // PM §17 — rich checklist responses. done is the completion flag; response
  // carries the recorded value for non-checkbox types; notes = technician note.
  required     Boolean   @default(false)
  responseType String    @default("CHECKBOX") // CHECKBOX | PASSFAIL | YESNO | NUMERIC | TEXT
  response     String    @default("")
  notes        String    @default("")
  sortOrder    Int       @default(0)
  // ── Checklist engine (AI checklist spec §9/§61/§64) — item provenance + structure.
  // These rows are the ONLY execution surface: once materialized from a checklist
  // version they are a frozen snapshot — later template/AI changes never alter them.
  origin              String  @default("MANUAL") // TEMPLATE | AI | MANUAL
  priority            String  @default("ROUTINE") // ROUTINE | IMPORTANT | SAFETY | CRITICAL
  safetyCritical      Boolean @default(false)
  expectedResult      String  @default("") // observation guidance only — never an AI-invented threshold
  unit                String  @default("") // observation unit for NUMERIC (V, A, °C, bar…)
  requiresPhoto       Boolean @default(false) // completion validation demands a checklist photo
  failRequiresFinding Boolean @default(false) // a FAIL/NO answer must carry a technician note
}

model WorkOrderMaterial {
  id              String         @id @default(cuid())
  workOrderId     String
  workOrder       WorkOrder      @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  inventoryItemId String?
  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)
  name            String
  quantity        Float
  unit            String         @default("pcs")
  unitCostCents   Int            @default(0)
  totalCents      Int            @default(0)
}

// ─────────────────────────── PREVENTIVE MAINTENANCE ───────────────────────────

model PmPlan {
  id                   String             @id @default(cuid())
  code                 String             @unique
  name                 String
  description          String             @default("")
  equipmentId          String
  equipment            Equipment          @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  // CALENDAR | METER | USAGE | RUNTIME | CONDITION | SEASONAL | INSPECTION
  // Engine mapping: METER/USAGE/RUNTIME → meter engine; the rest → calendar engine.
  planType             String             @default("CALENDAR")
  frequency            String             @default("MONTHLY") // DAILY | WEEKLY | BIWEEKLY | MONTHLY | EVERY_2_MONTHS | QUARTERLY | SEMI_ANNUAL | ANNUAL | CUSTOM
  customIntervalDays   Int? // CUSTOM frequency: every N days
  intervalUnits        Int? // "every N" with intervalUnit
  intervalUnit         String? // DAYS | WEEKS | MONTHS | YEARS
  monthlyOccurrence    String? // FIRST | SECOND | THIRD | FOURTH | LAST (§8 advanced recurrence)
  monthlyWeekday       Int? // 0=Sun … 6=Sat
  priority             String             @default("MEDIUM") // LOW | MEDIUM | HIGH | CRITICAL
  assignedTechnicianId String?
  assignedTechnician   TechnicianProfile? @relation("assignedPmPlans", fields: [assignedTechnicianId], references: [id], onDelete: SetNull)
  checklistTemplate    String             @default("[]") // JSON: [{label, required, responseType}]
  templateId           String?
  template             PmTemplate?        @relation(fields: [templateId], references: [id], onDelete: SetNull)
  startDate            DateTime?
  endDate              DateTime?
  estimatedMinutes     Int                @default(60)
  requiredSkills       String             @default("")
  safetyRequirements   String             @default("")
  instructions         String             @default("")
  requiredParts        String             @default("[]") // JSON: [{inventoryItemId?, name, quantity, unit}]
  // Meter-based PM (§9–§11)
  meterId              String?
  meter                EquipmentMeter?    @relation(fields: [meterId], references: [id], onDelete: SetNull)
  meterInterval        Float?
  nextDueMeter         Float?
  slaResponseHours     Int?
  slaCompletionHours   Int?
  approvedById         String?
  approvedAt           DateTime?
  active               Boolean            @default(true)
  nextDueDate          DateTime?
  lastCompletedAt      DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  tasks    PmTask[]
  findings PmFinding[]
}

model PmTask {
  id           String             @id @default(cuid())
  code         String             @unique
  planId       String
  plan         PmPlan             @relation(fields: [planId], references: [id], onDelete: Cascade)
  equipmentId  String
  equipment    Equipment          @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  technicianId String?
  technician   TechnicianProfile? @relation("assignedPmTasks", fields: [technicianId], references: [id], onDelete: SetNull)
  dueDate      DateTime
  priority     String             @default("MEDIUM") // LOW | MEDIUM | HIGH | CRITICAL
  // SCHEDULED | OVERDUE | IN_PROGRESS | COMPLETED | SKIPPED | CANCELLED | FAILED
  status       String             @default("SCHEDULED")
  completedAt  DateTime?
  notes        String             @default("")
  // §23/§61 idempotent occurrence identity (unique per plan)
  occurrenceKey        String?
  // §22/§25 — execution happens on the canonical Work Order (sourceType=PM)
  workOrderId  String?            @unique
  workOrder    WorkOrder?
  // §73 audited rescheduling
  rescheduleReason String         @default("")
  rescheduledAt    DateTime?
  rescheduledById  String?
  // §75 failed PM (unsafe/defective equipment) — requires a finding
  failedAt          DateTime?
  failureReason     String         @default("")
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  checklist PmTaskChecklistItem[]
  findings  PmFinding[]
  // photos: generic Document rows (resourceType="PM_TASK", resourceId=task.id)

  @@unique([planId, occurrenceKey])
  @@index([dueDate, status])
}

model PmTaskChecklistItem {
  id        String  @id @default(cuid())
  taskId    String
  task      PmTask  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label     String
  done      Boolean @default(false)
  sortOrder Int     @default(0)
}

// ─── PM §15/§54 — reusable task-template library (snapshot copied into plan) ───
model PmTemplate {
  id          String   @id @default(cuid())
  name        String
  category    String   @default("GENERAL") // HVAC | ELECTRICAL | PLUMBING | FIRE_PROTECTION | GENERATOR | LIFT | BUILDING | CIVIL | MECHANICAL | PEST_CONTROL | CLEANING | LANDSCAPE | GENERAL
  description String   @default("")
  // JSON: [{label, required, responseType}]
  items       String   @default("[]")
  active      Boolean  @default(true)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  plans PmPlan[]
}

// ─────────────────────────── CENTRALIZED CHECKLIST ENGINE ───────────────────────────
// One engine for Complaints / Work Orders / PM / IRMS (AI checklist spec §1/§82).
// ChecklistTemplate + versions = approved template library; ChecklistInstance =
// the versioned draft/snapshot attached to one source; execution ALWAYS happens
// through WorkOrderChecklistItem (materialized snapshot — spec §28).

model ChecklistTemplate {
  id                String   @id @default(cuid())
  name              String
  // Same category vocabulary as PmTemplate (HVAC | ELECTRICAL | PLUMBING | …)
  category          String   @default("GENERAL")
  // PREVENTIVE | CORRECTIVE | TROUBLESHOOTING | INSPECTION | COMMISSIONING | INSTALLATION | GENERAL
  workType          String   @default("GENERAL")
  equipmentCategory String   @default("") // optional narrower match against Equipment.category
  description       String   @default("")
  // JSON: [{label, description, required, responseType, priority, safetyCritical, expectedResult, unit, requiresPhoto, failRequiresFinding}]
  items             String   @default("[]")
  version           Int      @default(1) // current version; history in ChecklistTemplateVersion
  status            String   @default("ACTIVE") // ACTIVE | INACTIVE
  // LOW-RISK templates may activate automatically; safety-critical ones force review (spec §24)
  approvalRequired  Boolean  @default(false)
  requiredPhotos    Int      @default(0)
  requiredFindings  Int      @default(0)
  createdById       String?
  approvedById      String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  versions  ChecklistTemplateVersion[]
  instances ChecklistInstance[]

  @@index([category, workType])
}

model ChecklistTemplateVersion {
  id          String            @id @default(cuid())
  templateId  String
  template    ChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  version     Int
  items       String            @default("[]")
  changelog   String            @default("")
  createdById String?
  createdAt   DateTime          @default(now())

  @@unique([templateId, version])
}

model ChecklistInstance {
  id               String             @id @default(cuid())
  code             String             @unique
  title            String
  // COMPLAINT | WORK_ORDER | PM | IRMS — where this checklist came from
  sourceType       String
  sourceId         String
  // Attached work order (the execution container). Complaint/IRMS drafts attach
  // later when their work order is created (auto or manual).
  workOrderId      String?            @unique
  workOrder        WorkOrder?         @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  customerId       String?
  equipmentId      String?
  // AI | TEMPLATE | MANUAL | HYBRID (spec §64 labelling)
  origin           String             @default("MANUAL")
  // DRAFT | PENDING_APPROVAL | APPROVED | REJECTED | ACTIVE | COMPLETED | ARCHIVED (spec §4)
  status           String             @default("DRAFT")
  version          Int                @default(1) // current version; history in ChecklistInstanceVersion
  // Draft items (same shape as template items + per-item origin). Once approved
  // and attached they are materialized into WorkOrderChecklistItem and frozen.
  itemsJson        String             @default("[]")
  templateId       String?
  template         ChecklistTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  templateVersion  Int?
  aiGenerationId   String?
  approvalRequired Boolean            @default(true)
  approvedById     String?
  approvedAt       DateTime?
  rejectedReason   String             @default("")
  // §30/§63 — AI summary derived ONLY from recorded results (never invented).
  aiSummary        String             @default("")
  aiSummaryAt      DateTime?
  createdById      String?
  completedAt      DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  versions ChecklistInstanceVersion[]

  @@index([sourceType, sourceId])
  @@index([status])
  @@index([customerId])
}

model ChecklistInstanceVersion {
  id          String            @id @default(cuid())
  instanceId  String
  instance    ChecklistInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  version     Int
  origin      String            @default("MANUAL")
  itemsJson   String            @default("[]")
  note        String            @default("")
  createdById String?
  createdAt   DateTime          @default(now())

  @@unique([instanceId, version])
}

// §38/§80 — safe AI generation metadata. NEVER stores prompt bodies, secrets,
// credentials or unrelated customer data — only reproducibility metadata.
model ChecklistAiGeneration {
  id              String   @id @default(cuid())
  sourceType      String // COMPLAINT | WORK_ORDER | PM | IRMS
  sourceId        String
  workOrderId     String?
  templateId      String?
  templateVersion Int?
  promptVersion   String // e.g. checklist-generator-v1 (§40)
  provider        String   @default("z-ai")
  model           String   @default("")
  // COMPLETED | VALIDATION_FAILED | FAILED | FALLBACK_TEMPLATE
  status          String
  itemCount       Int      @default(0)
  error           String   @default("") // friendly reason only — no stack traces/raw AI output
  // Minimal non-sensitive context fingerprint (category/workType/equipment tag)
  contextSummary  String   @default("")
  instanceId      String?
  createdById     String?
  createdAt       DateTime @default(now())

  @@index([sourceType, sourceId])
}

// ─── PM §19 — findings / observations with corrective-work bridge ───
model PmFinding {
  id                    String     @id @default(cuid())
  pmTaskId              String?
  pmTask                PmTask?    @relation(fields: [pmTaskId], references: [id], onDelete: SetNull)
  workOrderId           String?
  planId                String?
  plan                  PmPlan?    @relation(fields: [planId], references: [id], onDelete: SetNull)
  equipmentId           String
  equipment             Equipment  @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  title                 String
  description           String     @default("")
  severity              String     @default("MEDIUM") // LOW | MEDIUM | HIGH | CRITICAL
  cause                 String     @default("")
  recommendation        String     @default("")
  immediateAction       String     @default("")
  followUpRequired      Boolean    @default(false)
  correctiveWorkOrderId String?    @unique
  correctiveWorkOrder   WorkOrder? @relation("pmCorrectiveWorkOrders", fields: [correctiveWorkOrderId], references: [id], onDelete: SetNull)
  createdById           String?
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  @@index([equipmentId])
  @@index([pmTaskId])
}

// ─── PM §9–§11 — multiple meters per asset with full reading history ───
model EquipmentMeter {
  id               String    @id @default(cuid())
  equipmentId      String
  equipment        Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  name             String // e.g. "Running Hours", "Mileage"
  unit             String    @default("h") // h | km | cycles | …
  currentReading   Float     @default(0)
  currentReadingAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  readings EquipmentMeterReading[]
  pmPlans  PmPlan[]

  @@index([equipmentId])
}

model EquipmentMeterReading {
  id           String         @id @default(cuid())
  meterId      String
  meter        EquipmentMeter @relation(fields: [meterId], references: [id], onDelete: Cascade)
  reading      Float
  readingDate  DateTime       @default(now())
  recordedById String?
  source       String         @default("MANUAL") // MANUAL | PM_EXECUTION | IMPORT
  notes        String         @default("")
  createdAt    DateTime       @default(now())

  @@index([meterId, readingDate])
}

// ─────────────────────────── IRMS (Inspections) ───────────────────────────

model IrmsProject {
  id           String    @id @default(cuid())
  code         String    @unique
  name         String
  customerId   String?
  customer     Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  siteLocation String    @default("")
  description  String    @default("")
  status       String    @default("ACTIVE") // PLANNING | ACTIVE | ON_HOLD | COMPLETED
  startDate    DateTime?
  endDate      DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  inspections InspectionReport[]
}

model InspectionReport {
  id                String             @id @default(cuid())
  code              String             @unique
  projectId         String
  project           IrmsProject        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  equipmentId       String?
  equipment         Equipment?         @relation(fields: [equipmentId], references: [id], onDelete: SetNull)
  workOrderId       String?
  workOrder         WorkOrder?         @relation("irmsWorkOrders", fields: [workOrderId], references: [id], onDelete: SetNull)
  title             String
  type              String             @default("ROUTINE") // ROUTINE | SAFETY | EQUIPMENT | PROJECT | OTHER
  priority          String             @default("MEDIUM") // LOW | MEDIUM | HIGH | URGENT
  inspectionDate    DateTime
  inspectorId       String?
  inspector         TechnicianProfile? @relation("inspectorReports", fields: [inspectorId], references: [id], onDelete: SetNull)
  status            String             @default("DRAFT") // DRAFT | SUBMITTED | IN_REVIEW | MANAGER_APPROVAL | CLIENT_REVIEW | APPROVED | REJECTED | ARCHIVED
  summary           String             @default("")
  overallCondition  String             @default("GOOD") // EXCELLENT | GOOD | FAIR | POOR | CRITICAL
  recommendations   String             @default("")
  // ── Work details (report builder tab 2) ──
  jobOrderNo        String             @default("")
  building          String             @default("")
  floor             String             @default("")
  room              String             @default("")
  taskDescription   String             @default("")
  scope             String             @default("")
  notes             String             @default("")
  correctiveActions String             @default("")
  rootCause         String             @default("")
  safetyNotes       String             @default("")
  materials         String             @default("")
  labourHours       Float              @default(0)
  completionPercent Int                @default(0)
  // ── Workflow / portal ──
  customerVisible   Boolean            @default(false) // shared to the customer portal once APPROVED
  revision          Int                @default(0)
  clientComment     String             @default("")
  submittedAt       DateTime?
  submittedById     String?
  reviewedAt        DateTime?
  reviewedById      String?
  approvedAt        DateTime?
  approvedById      String?
  rejectedAt        DateTime?
  rejectedById      String?
  archivedAt        DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  findings   InspectionFinding[]
  photos     InspectionPhoto[]
  signatures InspectionSignature[]
  approvals  InspectionApproval[]
  revisions  InspectionRevision[]

  @@index([status])
  @@index([projectId])
  @@index([inspectionDate])
}

model InspectionFinding {
  id             String           @id @default(cuid())
  reportId       String
  report         InspectionReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  finding        String
  severity       String           @default("MEDIUM") // LOW | MEDIUM | HIGH | CRITICAL
  recommendation String           @default("")
}

// ── IRMS photo management (non-destructive; originals never modified) ──
model InspectionPhoto {
  id           String           @id @default(cuid())
  reportId     String
  report       InspectionReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  category     String           @default("BEFORE") // BEFORE | AFTER | PROGRESS | DURING | INSPECTION | COMPLETION | DEFECT | EVIDENCE
  photoNo      String           @default("") // B001 / A001 / P001 / D001 / I001 / C001 / F001 / E001
  sortOrder    Int              @default(0)
  caption      String           @default("")
  swRef        String           @default("")
  room         String           @default("")
  building     String           @default("")
  storagePath  String           @default("") // original file (relative to uploads/irms/)
  displayPath  String           @default("") // processed display image (max 1600px, EXIF-rotated)
  thumbPath    String           @default("") // 320px thumbnail
  width        Int              @default(0)
  height       Int              @default(0)
  sizeBytes    Int              @default(0)
  mimeType     String           @default("image/jpeg")
  cameraModel  String           @default("")
  takenAt      DateTime?
  exif         String           @default("") // sanitized EXIF JSON — never exposed to customers
  annotation   String           @default("[]") // non-destructive annotation JSON (arrows/shapes/text)
  rotation     Int              @default(0) // user rotation applied at render time (0|90|180|270), original preserved
  uploadedById String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([reportId, category, sortOrder])
}

// ── IRMS wet-signatures (mouse / touch / stylus) ──
model InspectionSignature {
  id          String           @id @default(cuid())
  reportId    String
  report      InspectionReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  role        String // INSPECTOR | SUPERVISOR | MANAGER | CLIENT
  name        String
  signedById  String?
  signedAt    DateTime         @default(now())
  storagePath String
  revision    Int              @default(0) // revision the signature belongs to (history is never overwritten)

  @@index([reportId, revision])
}

// ── IRMS approval audit trail (every workflow transition) ──
model InspectionApproval {
  id         String           @id @default(cuid())
  reportId   String
  report     InspectionReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  step       String // SUBMIT | REVIEW | MANAGER_APPROVAL | CLIENT_REQUEST | CLIENT_APPROVE | APPROVE | REJECT | ARCHIVE | REOPEN
  fromStatus String
  toStatus   String
  comment    String           @default("")
  userId     String?
  userName   String           @default("")
  createdAt  DateTime         @default(now())

  @@index([reportId, createdAt])
}

// ── IRMS versioned revisions (approved records are never silently overwritten) ──
model InspectionRevision {
  id            String           @id @default(cuid())
  reportId      String
  report        InspectionReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  version       Int
  snapshot      String // full report JSON snapshot
  note          String           @default("")
  createdById   String?
  createdByName String           @default("")
