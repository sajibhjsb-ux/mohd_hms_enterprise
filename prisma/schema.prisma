model Counter {
  key   String @id
  value Int    @default(0)
}

// ─────────────────────────── PROFILE CHANGE REQUESTS ───────────────────────────
// Secure workflow for changing a user's own immutable identity fields (spec §15/§16):
// a normal user cannot change their phone number directly — they submit a request
// that a SUPER_ADMIN reviews and applies. This is a workflow queue, NOT a second
// profile table: the canonical User/Customer rows remain the only profile storage.
model ProfileChangeRequest {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Extensible field discriminator — only "PHONE" is used today.
  field         String    @default("PHONE")
  // Snapshot of the value at request time ("" = not yet registered).
  currentValue  String    @default("")
  proposedValue String
  // PENDING | APPROVED | REJECTED | CANCELED
  status        String    @default("PENDING")
  decidedById   String?
  decidedByName String?
  decidedAt     DateTime?
  decisionNote  String    @default("")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([userId, status])
}

model Draft {
  id        String   @id @default(cuid())
  userId    String
  formKey   String
  data      String // JSON payload
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, formKey])
}

// ─────────────────────────────── LEGAL / CONSENT ───────────────────────────────

// Canonical legal documents (Terms & Conditions, Privacy Policy). ONE source of
// truth per kind: content is stored as structured PLAIN-TEXT sections (never
// HTML — nothing to sanitize, nothing can inject markup) and rendered by the
// /terms and /privacy pages, the customer consent gate and the public API.
// Published versions are immutable: corrections ship as a new version, and
// publishing a draft archives the previously published document.
model LegalDocument {
  id            String    @id @default(cuid())
  // TERMS | PRIVACY
  kind          String
  // e.g. "1.0" — unique per kind
  version       String
  // DRAFT | PUBLISHED | ARCHIVED
  status        String    @default("DRAFT")
  // Configurable by the company; left NULL until management/legal approval —
  // the UI then shows the document as pending effective-date approval.
  effectiveDate DateTime?
  publishedAt   DateTime?
  changeSummary String    @default("")
  // JSON: [{ id, title, body, needsReview? }] — plain text bodies.
  sections      String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  acceptances LegalAcceptance[]

  @@unique([kind, version])
  @@index([kind, status])
}

// Append-only acceptance evidence: one record per user per document version.
// Created ONLY by the accept endpoint (never by the UI directly) and never
// editable by customers. Unique [userId, documentId] makes acceptance
// idempotent — accepting the same version twice stores a single record.
model LegalAcceptance {
  id         String        @id @default(cuid())
  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  documentId String
  document   LegalDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  // Denormalized from the document so records stay meaningful even if a
  // document row were ever removed.
  kind       String
  version    String
  // WEB_APP | CUSTOMER_ONBOARDING | … — where the acceptance happened.
  context    String        @default("WEB_APP")
  ip         String?
  userAgent  String?
  acceptedAt DateTime      @default(now())

  @@unique([userId, documentId])
  @@index([userId])
  @@index([documentId])
}

// ─────────────────────────── HR LETTERS (template engine + generation) ───────────────────────────
// Enterprise letter generation: reusable TEMPLATES (versioned, immutable
// snapshots) → LETTERS created from a template with structured data → optional
// AI draft for the body only (template structure stays deterministic) → human
// review/approval workflow → FINAL PDF stored in S3 object storage (MinIO API)
// with metadata in the database. Finalized letters are immutable: the rendered
// document and its template snapshot never change after finalization.
model LetterTemplate {
  id              String    @id @default(cuid())
  // Human template code, e.g. LOU-001 / LOA-001 / SUB-001 (unique).
  code            String    @unique
  name            String
  // LOU | LOA | SUBMISSION | CLARIFICATION | APPOINTMENT | CONFIRMATION |
  // WARNING | EMPLOYMENT | VERIFICATION | TRAINING | REFERENCE | GENERAL | CUSTOM
  letterType      String
  description     String    @default("")
  department      String    @default("HR")
  // Current content version (incremented on every content edit; every bump
  // writes an immutable LetterTemplateVersion snapshot).
  version         Int       @default(1)
  // ACTIVE | INACTIVE | ARCHIVED
  status          String    @default("ACTIVE")
  language        String    @default("en")
  pageSize        String    @default("A4")
  defaultFont     String    @default("Helvetica")
  effectiveDate   DateTime?
  // Default template for its letter type (one per type).
  isDefault       Boolean   @default(false)
  // Approved instruction set for the AI drafting assistant (§3/§9).
  aiInstructions  String    @default("")
  subjectHint     String    @default("")
  // Deterministic body skeleton with {{PLACEHOLDERS}}; the {{BODY}} slot is
  // where the AI-generated (or manually written) content is placed (§46).
  bodyTemplate    String    @default("")
  closingTemplate String    @default("Yours faithfully,")
  // JSON: TemplateField[] — { key, label, type, required, options?, hint?, ai? }
  fieldsJson      String    @default("[]")
  createdById     String?
  updatedById     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  versions LetterTemplateVersion[]
  letters  Letter[]

  @@index([letterType, status])
}

// Immutable content snapshot per template version. Letters reference the exact
// version + carry their own snapshot, so editing a template NEVER changes
// previously generated letters (§27 — auditability).
model LetterTemplateVersion {
  id            String         @id @default(cuid())
  templateId    String
  template      LetterTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  version       Int
  // JSON snapshot of all content-bearing template fields at this version.
  snapshotJson  String
  createdById   String?
  createdByName String         @default("")
  createdAt     DateTime       @default(now())

  @@unique([templateId, version])
  @@index([templateId])
}

model Letter {
  id                   String          @id @default(cuid())
  // Configurable official reference, e.g. HMS/HR/LOU/2026/0001 (§17) —
  // generated server-side from a Counter (transactional, no duplicates).
  letterNumber         String          @unique
  letterType           String
  templateId           String?
  template             LetterTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  // Exact template version used (§27).
  templateVersion      Int             @default(1)
  // Immutable content snapshot of the template at creation time.
  templateSnapshotJson String          @default("{}")
  // DRAFT | AI_GENERATED | UNDER_REVIEW | APPROVED | REJECTED | FINALIZED | SENT | ARCHIVED
  status               String          @default("DRAFT")
  // Official letter date (server clock / Asia/Brunei authoritative, §18).
  letterDate           DateTime        @default(now())

  // Structured field values keyed by template field key (JSON).
  dataJson      String @default("{}")
  // AI/human-authored content that fills the template's {{BODY}} slot (§46).
  bodySlot      String @default("")
  // Fully rendered body = template wrapper with {{BODY}} ← bodySlot resolved.
  // `body` is what preview + PDF print; `bodySlot` is what the AI writes and
  // the human edits — the wrapper is always re-rendered from the template
  // snapshot so AI/human can never break the template structure (§11).
  subject       String @default("")
  body          String @default("")
  salutation    String @default("")
  closing       String @default("Yours faithfully,")
  // TEMPLATE | AI | HUMAN_EDITED — what last wrote the body (§45 content
  // protection: regeneration never silently overwrites human edits).
  contentSource String @default("TEMPLATE")

  // Denormalized for list/search/filter performance (§29/§30).
  recipientName    String    @default("")
  recipientCompany String    @default("")
  // Optional employee/customer link for auto-population + scoping (§31/§32).
  employeeId       String?
  employee         Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  // Signatory (§22) — signature image lives in object storage, never in the DB.
  signatoryName         String @default("")
  signatoryPosition     String @default("")
  signatorySignatureKey String @default("")

  // Final document object keys (S3/MinIO, §23): letters/{year}/{type}/{id}/final.pdf
  pdfObjectKey String    @default("")
  pdfSizeBytes Int       @default(0)
  finalizedAt  DateTime?

  // Workflow (§16)
  createdById    String?
  createdByName  String    @default("")
  updatedById    String?
  approvedById   String?
  approvedByName String    @default("")
  approvedAt     DateTime?
  sentAt         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  attachments LetterAttachment[]
  events      LetterEvent[]

  @@index([status])
  @@index([letterType])
  @@index([createdAt])
}

model LetterAttachment {
  id           String   @id @default(cuid())
  letterId     String
  letter       Letter   @relation(fields: [letterId], references: [id], onDelete: Cascade)
  name         String
  objectKey    String
  sizeBytes    Int      @default(0)
  mimeType     String   @default("")
  uploadedById String?
  createdAt    DateTime @default(now())

  @@index([letterId])
}

// Append-only letter activity trail (§43) — complements the central AuditLog
// with a letter-scoped timeline rendered in the UI.
model LetterEvent {
  id        String   @id @default(cuid())
  letterId  String
  letter    Letter   @relation(fields: [letterId], references: [id], onDelete: Cascade)
  action    String // CREATED | AI_GENERATED | AI_REGENERATED | AI_ACTION | EDITED | SUBMITTED | APPROVED | REJECTED | FINALIZED | SENT | SHARED | DOWNLOADED | ARCHIVED | SIGNATURE_SET | ATTACHMENT_ADDED | ATTACHMENT_REMOVED
  detail    String   @default("")
  actorId   String?
  actorName String   @default("")
  createdAt DateTime @default(now())

  @@index([letterId, createdAt])
}

// ─────────────────────────── WORKFLOW ENGINE (outbox + runs) ───────────────────────────
// DomainEvent is the transactional outbox: business services write the event in the
// same transaction as their data change; the outbox worker processes it exactly once
// (claim guard), retries with exponential backoff and dead-letters after max attempts.

model DomainEvent {
  id            String    @id @default(cuid())
  type          String // COMPLAINT_CREATED, COMPLAINT_CONFIRMED, LOW_STOCK, PM_DUE, EMAIL_SEND …
  resourceType  String    @default("")
  resourceId    String    @default("")
  payload       String    @default("{}") // JSON
  // PENDING → PROCESSING → DONE | DEAD (PENDING again on retry)
  status        String    @default("PENDING")
  attempts      Int       @default(0)
  maxAttempts   Int       @default(5)
  nextAttemptAt DateTime  @default(now())
  lastError     String    @default("")
  requestId     String    @default("")
  actorType     String    @default("USER") // USER | SYSTEM
  actorId       String?
  createdAt     DateTime  @default(now())
  processedAt   DateTime?
  // Realtime dispatch (STEP 5/7/22): the outbox worker hands committed events to
  // the realtime service. NULL = not yet broadcast; the dispatcher polls for
  // un-broadcast recent events (missed-event recovery + push failure retry).
  broadcastAt   DateTime?

  runs WorkflowRun[]

  @@index([status, nextAttemptAt])
  @@index([type, createdAt])
  @@index([resourceType, resourceId])
  @@index([broadcastAt, createdAt])
}

// One immutable record per workflow execution attempt. The unique [eventId, workflow]
// index on SUCCESS results is the idempotency key: a retried event never re-executes
// a workflow that already succeeded (handlers double-check business state as well).
model WorkflowRun {
  id           String      @id @default(cuid())
  eventId      String
  event        DomainEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  workflow     String // AUTO_CREATE_DRAFT_INVOICE, LOW_STOCK_ALERT, ESCALATE_COMPLAINT …
  resourceType String      @default("")
  resourceId   String      @default("")
  // SUCCESS | SKIPPED | FAILED
  result       String      @default("SUCCESS")
  detail       String      @default("") // e.g. created invoice code / skip reason
  actorType    String      @default("SYSTEM") // SYSTEM | USER
  attempt      Int         @default(1)
  startedAt    DateTime    @default(now())
  completedAt  DateTime?

  @@index([workflow, startedAt])
  @@index([resourceType, resourceId])
}

// ─────────────────────────── EMAIL AUTOMATION + CONFIGURATION ───────────────────────────
// ONE centralized email system (spec: Email Automation + Email Configuration).
//   EmailConfig          — singleton SMTP/provider configuration (secret AES-GCM encrypted,
//                          NEVER returned to the frontend in plaintext)
//   EmailTemplate(+Ver)  — versioned HTML templates (content edit = version bump +
//                          immutable snapshot; sent logs store the exact version used)
//   EmailAutomation      — event-driven rules resolved from DomainEvent outbox events
//                          (idempotent per [eventId, automationId], controlled conditions)
//   EmailLog             — the ONE authoritative email job/history record
//                          (QUEUED → PROCESSING → SMTP_ACCEPTED → SENT | FAILED → DEAD_LETTER,
//                          CANCELED; retries with backoff; attachment refs point at MinIO)

model EmailConfig {
  id            String    @id @default("singleton")
  provider      String    @default("SMTP") // SMTP (Mailflare endpoint in production)
  smtpHost      String    @default("")
  smtpPort      Int       @default(587)
  // NONE | SSL | STARTTLS
  smtpSecurity  String    @default("STARTTLS")
  smtpUser      String    @default("")
  // AES-256-GCM encrypted; plaintext never stored, never logged, never sent to the client.
  smtpSecretEnc String    @default("")
  fromName      String    @default("")
  fromEmail     String    @default("")
  replyTo       String    @default("")
  timeoutMs     Int       @default(15000)
  testRecipient String    @default("")
  // Set the first time the configuration becomes usable (host + from configured).
  configuredAt  DateTime?
  lastVerifyAt  DateTime?
  lastVerifyOk  Boolean?
  updatedAt     DateTime  @updatedAt
}

model EmailTemplate {
  id          String    @id @default(cuid())
  // Canonical variable key, e.g. PASSWORD_RESET_OTP, INVOICE_SENT, COMPLAINT_ASSIGNED.
  key         String    @unique
  name        String
  // AUTHENTICATION | CUSTOMER | COMPLAINTS | WORK_ORDERS | QUOTATIONS | INVOICES | PAYMENTS
  // | PURCHASES | HR | PROJECTS | IRMS | LETTERS | SYSTEM | REPORTS
  category    String    @default("SYSTEM")
  description String    @default("")
  subject     String    @default("")
  bodyHtml    String    @default("")
  // JSON array of variable names this template may use (drives the UI variable chips).
  variables   String    @default("[]")
  isActive    Boolean   @default(true)
  isSystem    Boolean   @default(true) // canonical catalog (extensible, not deletable while referenced)
  // Security-critical templates (OTP) can never be disabled/skipped by user preferences.
  critical    Boolean   @default(false)
  version     Int       @default(1)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  versions EmailTemplateVersion[]

  @@index([category, isActive])
}

// Immutable snapshot written on every content-affecting edit (subject/body).
model EmailTemplateVersion {
  id         String        @id @default(cuid())
  templateId String
  template   EmailTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  version    Int
  subject    String        @default("")
  bodyHtml   String        @default("")
  editedBy   String        @default("")
  createdAt  DateTime      @default(now())

  @@unique([templateId, version])
}

model EmailAutomation {
  id            String   @id @default(cuid())
  name          String
  // DomainEvent type that triggers this automation (COMPLAINT_ASSIGNED, INVOICE_SENT, …).
  eventType     String
  templateKey   String
  // JSON RecipientRule: { kind: CUSTOMER|RELATED_USER|ROLE|MODULE_MAILBOX|FIXED, value? }
  recipientRule String   @default("{}")
  // Optional per-automation sender identity override (must be admin-configured).
  senderName    String   @default("")
  senderEmail   String   @default("")
  replyTo       String   @default("")
  // Optional delayed sending (minutes after the event commits).
  delayMinutes  Int      @default(0)
  // JSON [{field,op,value}] — evaluated server-side against resolved, authorized data.
  conditions    String   @default("[]")
  // JSON AttachmentSpec[]: { kind: INVOICE_PDF|QUOTATION_PDF|WO_PDF|INSPECTION_PDF|LETTER_PDF }
  // resolved through authorized application entities — never raw object keys.
  attachments   String   @default("[]")
  enabled       Boolean  @default(true)
  // Security-critical automations cannot be disabled without SUPER_ADMIN.
  critical      Boolean  @default(false)
  maxAttempts   Int      @default(3)
  // Extra dedupe window (hours) for alert-style events (0 = idempotency key only).
  dedupeHours   Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  logs EmailLog[]

  @@unique([eventType, name])
  @@index([eventType, enabled])
}

model EmailLog {
  id               String           @id @default(cuid())
  // QUEUED | PROCESSING | SMTP_ACCEPTED | SENT | FAILED | DEAD_LETTER | CANCELED
  status           String           @default("QUEUED")
  // DomainEvent id that produced this email ("" for direct/admin sends).
  eventId          String           @default("")
  automationId     String?
  automation       EmailAutomation? @relation(fields: [automationId], references: [id], onDelete: SetNull)
  templateKey      String           @default("")
  templateVersion  Int              @default(0)
  category         String           @default("SYSTEM")
  toEmail          String
  toUserId         String           @default("")
  cc               String           @default("")
  bcc              String           @default("")
  replyTo          String           @default("")
  fromName         String           @default("")
  fromEmail        String           @default("")
  subject          String           @default("")
  // Rendered body (retention-controlled: pruned by the worker after the window).
  bodyHtml         String           @default("")
  bodyPrunedAt     DateTime?
  relatedType      String           @default("")
  relatedId        String           @default("")
  attemptCount     Int              @default(0)
  maxAttempts      Int              @default(3)
  scheduledAt      DateTime         @default(now())
  sentAt           DateTime?
  failedAt         DateTime?
  lastError        String           @default("")
  // TEMPORARY | PERMANENT | AUTHENTICATION | RECIPIENT | RATE_LIMIT | NETWORK | PROVIDER | CONFIG
  errorClass       String           @default("")
  messageId        String           @default("")
  providerResponse String           @default("")
  // JSON [{kind,label,filename,key}] — references ONLY (files live in MinIO).
  attachmentRefs   String           @default("[]")
  // Admin test sends are always clearly marked.
  isTest           Boolean          @default(false)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([eventId, automationId])
  @@index([status, scheduledAt])
  @@index([category, createdAt])
  @@index([toEmail, createdAt])
  @@index([relatedType, relatedId])
  @@index([automationId, createdAt])
}

// ═══════════════════════════════════════════════════════════════════
// WHATSAPP AUTOMATION (OpenWA gateway integration)
// OpenWA = transport ONLY. MOHD.HMS remains the system of record:
// business data lives in the existing models; media bytes live in MinIO;
// this section stores config + message/conversation metadata + template
// + automation rules + webhook idempotency only.
// ═══════════════════════════════════════════════════════════════════

model WhatsAppConfig {
  id                String    @id @default("singleton")
  // OpenWA gateway REST base URL (server-side only, never exposed to browser).
  gatewayBaseUrl    String    @default("http://127.0.0.1:2785")
  // AES-256-GCM encrypted OpenWA API key (X-API-Key) — never returned by any API.
  apiKeyEnc         String    @default("")
  // AES-256-GCM encrypted webhook signing secret handed to OpenWA; OpenWA signs
  // deliveries with X-OpenWA-Signature: sha256=<hex> over the raw body.
  webhookSecretEnc  String    @default("")
  // Session identity in the gateway (configurable, not hardcoded).
  sessionName       String    @default("mohd-hms-production")
  // Toggle for the whole integration (kill switch).
  enabled           Boolean   @default(false)
  // Inbound automation gate (auto-replies + complaint creation from WhatsApp).
  autoReplies       Boolean   @default(true)
  // Mirror of the OpenWA session state (honest values from the gateway only).
  // created | initializing | qr_ready | authenticating | ready | disconnected | action_required | failed | unknown
  sessionStatus     String    @default("unknown")
  sessionPhone      String    @default("")
  sessionPushName   String    @default("")
  sessionError      String    @default("")
  lastConnectedAt   DateTime?
  lastHeartbeatAt   DateTime?
  lastInboundAt     DateTime?
  lastOutboundAt    DateTime?
  webhookRegistered Boolean   @default(false)
  webhookId         String    @default("")
  // Admin test message recipient (normalized E.164).
  testRecipient     String    @default("")
  configuredAt      DateTime?
  updatedAt         DateTime  @updatedAt
}

model WhatsAppContact {
  id                    String                 @id @default(cuid())
  // Canonical WhatsApp chat id for individual chats: "<digits>@c.us".
  chatId                String                 @unique
  // Canonical E.164 phone (e.g. +6737123456) — the business identity key.
  phone                 String                 @default("")
  // "CUSTOMER" | "STAFF" — business role of this contact.
  kind                  String                 @default("CUSTOMER")
  customerId            String?
  customer              Customer?              @relation(fields: [customerId], references: [id], onDelete: SetNull)
  userId                String?
  user                  User?                  @relation("WhatsAppContactUser", fields: [userId], references: [id], onDelete: SetNull)
  // WhatsApp display name (push name) — cosmetic only, never an identity.
  waName                String                 @default("")
  // Per-contact automation opt-out (business safety §41).
  automationEnabled     Boolean                @default(true)
  verified              Boolean                @default(false)
  notes                 String                 @default("")
  lastMessageAt         DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  messages              WhatsAppMessage[]
  whatsAppConversations WhatsAppConversation[]

  @@index([customerId])
  @@index([phone])
}

model WhatsAppConversation {
  id                 String            @id @default(cuid())
  chatId             String            @unique
  contactId          String?
  contact            WhatsAppContact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  customerId         String?
  customer           Customer?         @relation("WhatsAppConversationCustomer", fields: [customerId], references: [id], onDelete: SetNull)
  // BOT = automated replies allowed; HUMAN = human handoff active (bot silent); CLOSED = archived.
  state              String            @default("BOT")
  assignedAgentId    String            @default("")
  unreadCount        Int               @default(0)
  lastMessageAt      DateTime?
  lastMessagePreview String            @default("")
  lastInboundAt      DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  messages           WhatsAppMessage[]

  @@index([state, lastMessageAt])
  @@index([customerId])
}

model WhatsAppMessage {
  id                String                @id @default(cuid())
  conversationId    String?
  conversation      WhatsAppConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  chatId            String
  contactId         String?
  contact           WhatsAppContact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  // INBOUND | OUTBOUND
  direction         String
  // fromMe guard (loop prevention §40): outbound/system messages are never re-processed.
  fromMe            Boolean               @default(false)
  // QUEUED | SENDING | SENT | DELIVERED | READ | RECEIVED | FAILED | CANCELED
  status            String                @default("QUEUED")
  // text | image | document | audio | video | location | unknown
  type              String                @default("text")
  body              String                @default("")
  // Media reference — bytes live in MinIO (whatsapp/* prefix); never in PostgreSQL/SQLite.
  mediaKey          String                @default("")
  mediaMimetype     String                @default("")
  mediaFilename     String                @default("")
  mediaSize         Int                   @default(0)
  // OpenWA provider message id (for ack correlation + inbound dedupe).
  providerMessageId String                @default("")
  // Template provenance (traceability §38).
  templateKey       String                @default("")
  templateVersion   Int                   @default(0)
  // DomainEvent id ("" for direct/staff sends) + producing automation.
  eventId           String                @default("")
  automationId      String?
  automation        WhatsAppAutomation?   @relation(fields: [automationId], references: [id], onDelete: SetNull)
  // Business linkage (CUSTOMER | COMPLAINT | WORK_ORDER | QUOTATION | INVOICE | PAYMENT | ...).
  relatedType       String                @default("")
  relatedId         String                @default("")
  // Delivery state machine.
  attemptCount      Int                   @default(0)
  maxAttempts       Int                   @default(3)
  scheduledAt       DateTime              @default(now())
  sentAt            DateTime?
  failedAt          DateTime?
  lastError         String                @default("")
  // TEMPORARY | PERMANENT | AUTHENTICATION | NETWORK | PROVIDER | CONFIG | RATE_LIMIT
  errorClass        String                @default("")
  isTest            Boolean               @default(false)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@unique([chatId, providerMessageId, direction])
  @@unique([eventId, automationId])
  @@index([status, scheduledAt])
  @@index([chatId, createdAt])
  @@index([conversationId, createdAt])
  @@index([relatedType, relatedId])
  @@index([automationId, createdAt])
}

model WhatsAppTemplate {
  id          String                    @id @default(cuid())
  key         String                    @unique // canonical key e.g. COMPLAINT_CREATED
  name        String
  category    String                    @default("SYSTEM")
  description String                    @default("")
  // Plain-text WhatsApp body with {{VARIABLE}} placeholders.
  body        String                    @default("")
  // JSON array of variable names — allowlist, resolved server-side only.
  variables   String                    @default("[]")
  isActive    Boolean                   @default(true)
  isSystem    Boolean                   @default(true)
  critical    Boolean                   @default(false)
  version     Int                       @default(1)
  deletedAt   DateTime?
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt
  versions    WhatsAppTemplateVersion[]

  @@index([category, isActive])
}

model WhatsAppTemplateVersion {
  id         String           @id @default(cuid())
  templateId String
  template   WhatsAppTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  version    Int
  body       String           @default("")
  editedBy   String           @default("")
  createdAt  DateTime         @default(now())

  @@unique([templateId, version])
}

model WhatsAppAutomation {
  id            String            @id @default(cuid())
  name          String
  // DomainEvent type trigger (real business events only).
  eventType     String
  templateKey   String
  // JSON RecipientRule: {kind: CUSTOMER|RELATED_USER|ROLE|FIXED, value?}
  recipientRule String            @default("{}")
  // JSON [{field,op,value}] conditions evaluated against the event payload.
  conditions    String            @default("[]")
  // JSON AttachmentKind[] e.g. ["INVOICE_PDF"] — resolved via the central PDF engine/MinIO.
  attachments   String            @default("[]")
  delayMinutes  Int               @default(0)
  dedupeHours   Int               @default(0)
  enabled       Boolean           @default(true)
  critical      Boolean           @default(false)
  maxAttempts   Int               @default(3)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  messages      WhatsAppMessage[]

  @@unique([eventType, name])
  @@index([eventType, enabled])
}

model WhatsAppWebhookEvent {
  id             String    @id @default(cuid())
  // OpenWA delivery idempotency key (X-OpenWA-Idempotency-Key) — UNIQUE = the dedupe anchor.
  idempotencyKey String    @unique
  deliveryId     String    @default("")
  sessionId      String    @default("")
  // message.received | message.ack | message.failed | session.status | session.qr | ...
  event          String
  // JSON raw payload (bounded; media bytes never stored here).
  payload        String    @default("{}")
  // RECEIVED | PROCESSED | DUPLICATE | FAILED
  status         String    @default("RECEIVED")
  error          String    @default("")
  receivedAt     DateTime  @default(now())
  processedAt    DateTime?

  @@index([event, receivedAt])
  @@index([status])
}
