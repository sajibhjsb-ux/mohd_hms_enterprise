  @@index([userId, readAt])
}

model Document {
  id           String   @id @default(cuid())
  name         String
  safeName     String
  mimeType     String
  sizeBytes    Int
  storagePath  String
  category     String   @default("GENERAL") // COMPLAINT | WORK_ORDER | EQUIPMENT | INSPECTION | QUOTATION | INVOICE | EMPLOYEE | GENERAL
  resourceType String   @default("")
  resourceId   String   @default("")
  // PM §20 — evidence phase label: BEFORE | DURING | AFTER | FINDING | METER | ""
  label        String   @default("")
  uploadedById String?
  createdAt    DateTime @default(now())
}

model Setting {
