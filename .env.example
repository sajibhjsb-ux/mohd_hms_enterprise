# MOHD.HMS ENTERPRISE — environment template (copy to .env, never commit real values)

# ── Database (authoritative store) ──
DATABASE_URL="file:./custom.db"
# Production (PostgreSQL): flip provider + URL together in prisma/schema.prisma.
# DATABASE_URL="postgresql://user:password@host:5432/mohd_hms"

# ── Web Push (legacy VAPID transport — fallback when Firebase is absent) ──
# Generate a keypair: npx web-push generate-vapid-keys
# The PUBLIC key is public by design (served to browsers); keep the private key server-only.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:it@mohdhms.com

# ── Firebase Cloud Messaging (primary push transport, spec §2/§38) ──
# Server-only credential — ONE of the following:
#   a) inline service-account JSON (recommended: single secret)
# FIREBASE_SERVICE_ACCOUNT={"project_id":"...","client_email":"...","private_key":"..."}
#   b) path to the key file mounted outside the repo
# FIREBASE_SERVICE_ACCOUNT_PATH=/run/secrets/firebase-service-account.json
#   c) split fields (secret managers that cannot hold raw JSON)
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
#
# PUBLIC web client configuration (safe to serve to browsers; no secrets):
# Required for the web client to register devices:
FIREBASE_CLIENT_API_KEY=
FIREBASE_CLIENT_AUTH_DOMAIN=
FIREBASE_CLIENT_STORAGE_BUCKET=
FIREBASE_CLIENT_MESSAGING_SENDER_ID=
FIREBASE_CLIENT_APP_ID=
# Optional (only if the app uses Firebase Analytics):
# FIREBASE_CLIENT_MEASUREMENT_ID=
# Web Push certificate PUBLIC key (Firebase console → Cloud Messaging → Web Push certificates):
FIREBASE_VAPID_KEY=
#
# Firebase console setup checklist:
#   1. Enable the FCM HTTP v1 API (it is on by default for new projects).
#   2. Generate a Web Push certificate and set FIREBASE_VAPID_KEY.
#   3. Add the production domain (https://www.mohdhms.com) under
#      Authentication → Settings → Authorized domains (needed for PWA installs).
#   4. Enable "Push notifications" in the app: Settings → Automation.

# ── Central QR system (ch.35) ──
# HMAC-SHA256 signing secret for QR verification identities. Falls back to
# EMAIL_CRYPTO_SECRET → OTP_HASH_SECRET → NEXTAUTH_SECRET when absent.
# Set an explicit strong secret in production (rotating it invalidates every
# existing QR signature — regenerate identities after rotation).
QR_SIGNING_SECRET=
# Public origin encoded inside every QR code (verification URLs must work
# outside the LAN, QR spec §2/§3/§34/§47). CANONICAL production value:
#   https://app.mohdhms.com
# Resolution order in QRService: Settings → public_url (admin-editable,
# single authoritative source) → this env → request origin (dev fallback).
# Never a private LAN address or localhost in production QR codes.
PUBLIC_APP_URL=https://app.mohdhms.com
